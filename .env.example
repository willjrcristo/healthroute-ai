# HealthRoute AI — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores

# Provedor LLM: local | openai | groq | gemini
LLM_PROVIDER=local

# OpenAI
OPENAI_API_KEY=sk-...

# Groq (DeepSeek / Llama)
GROQ_API_KEY=gsk_...

# Google Gemini
GEMINI_API_KEY=...

# n8n Webhook URL
N8N_WEBHOOK_URL=http://localhost:5678/webhook/vrp
